// store.mere — a git object store, read-only: loose objects and packs.
//
//   store_open gitdir         -> unit      read the pack indexes (once)
//   store_read hex            -> (typ, ByteBuf)   typ 1 commit 2 tree 3 blob
//                                          4 tag, 0 = no such object
//   store_all ()              -> str list  every object id, loose and packed,
//                                          sorted, each once
//   type_name typ             -> str
//
// The object's bytes come back in a ByteBuf made in the CALLER's region, and
// that is the whole memory design: a caller walking fifty thousand objects
// reads each one inside `region R { ... }`, and what that object cost goes back
// when the block ends. Most of it does since Mere v0.1.559, when a region
// parameter began to reach calls made from inner functions; what does not is
// what no function's type names -- the inflater's tables, and the streams a
// delta chain inflates and drops -- which Mere puts in the default region (the
// README has the numbers). Nothing is cached across objects, so a delta whose
// chain is fifty deep inflates fifty streams.
//
// Formats: gitformat-pack(5) -- idx v2 (fan-out, sorted ids, CRCs, 31-bit
// offsets with a 64-bit overflow table), pack v2 entries (type and size in a
// little-endian base-128 varint; OBJ_OFS_DELTA's offset in git's own
// "+1 per continuation" varint; OBJ_REF_DELTA's base by id), and the delta
// opcodes (copy from base / insert literal).
import "mgz/inflate.mere";

// A pack is a number: the i-th entry of each of these. (A record of these held
// in a Vec did not compile for C.)
let pk_idx = vec_new ();
let pk_file = vec_new ();
let pk_size = vec_new ();
let pk_count = vec_new ();
let pk_offs = vec_new ();

// bytes [off, off+len) of a ByteBuf, as bytes
let bb_range = fn (b) -> fn (off: int) -> fn (len: int) ->
  let t = bytebuf_new 0 in
  let rec go = fn (i: int) -> if i == len then () else let _ = bytebuf_push t (bytebuf_get b (off + i)) in go (i + 1) in
  let _ = go 0 in
  bytes_of_bytebuf t;

let git_dir = vec_new ();

let type_name = fn (t: int) ->
  if t == 1 then "commit" else if t == 2 then "tree" else if t == 3 then "blob"
  else if t == 4 then "tag" else "unknown";

let type_of_name = fn (s: str) ->
  if s == "commit" then 1 else if s == "tree" then 2 else if s == "blob" then 3
  else if s == "tag" then 4 else 0;

// ---- idx v2 ----------------------------------------------------------------

let be32 = fn (b: bytes) -> fn (o: int) ->
  bit_or (bit_or (bit_shl (bytes_get b o) 24) (bit_shl (bytes_get b (o + 1)) 16))
         (bit_or (bit_shl (bytes_get b (o + 2)) 8) (bytes_get b (o + 3)));

let fanout = fn (idx: bytes) -> fn (i: int) -> if i < 0 then 0 else be32 idx (8 + 4 * i);

// the pack offset of the k-th object in index order
let idx_offset = fn (p: int) -> fn (k: int) ->
  let n = (vec_get pk_count p : int) in
  let v = be32 (vec_get pk_idx p : bytes) (8 + 1024 + 24 * n + 4 * k) in
  if v < 2147483648 then v
  else
    // MSB set: the rest indexes the 64-bit table
    let j = v - 2147483648 in
    let o = 8 + 1024 + 28 * n + 8 * j in
    bit_or (bit_shl (be32 (vec_get pk_idx p : bytes) o) 32) (be32 (vec_get pk_idx p : bytes) (o + 4));

// compare id (20 bytes) with the k-th id of the index: -1, 0, 1
let idx_cmp = fn (p: int) -> fn (id: bytes) -> fn (k: int) ->
  let base = 8 + 1024 + 20 * k in
  let rec go = fn (i: int) ->
    if i == 20 then 0
    else
      let a = bytes_get id i in
      let b = bytes_get (vec_get pk_idx p : bytes) (base + i) in
      if a < b then 0 - 1 else if a > b then 1 else go (i + 1) in
  go 0;

// index position of id in p, or -1
let idx_find = fn (p: int) -> fn (id: bytes) ->
  let first = bytes_get id 0 in
  let rec search = fn (lo: int) -> fn (hi: int) ->
    if lo >= hi then 0 - 1
    else
      let mid = (lo + hi) / 2 in
      let c = idx_cmp p id mid in
      if c == 0 then mid else if c < 0 then search lo mid else search (mid + 1) hi in
  search (fanout (vec_get pk_idx p : bytes) (first - 1)) (fanout (vec_get pk_idx p : bytes) first);

// the offset after `o` in the pack: where the entry at `o` stops
let next_offset = fn (p: int) -> fn (o: int) ->
  let rec search = fn (lo: int) -> fn (hi: int) ->
    if lo >= hi then lo
    else
      let mid = (lo + hi) / 2 in
      if vec_get (vec_get pk_offs p) mid <= o then search (mid + 1) hi else search lo mid in
  let k = search 0 (vec_len (vec_get pk_offs p)) in
  if k < vec_len (vec_get pk_offs p) then vec_get (vec_get pk_offs p) k else (vec_get pk_size p : int) - 20;

let open_pack = fn (base: str) ->
  let idx = read_bytes (base ++ ".idx") in
  let ok = bytes_len idx > 1032 && be32 idx 0 == 4285812579 && be32 idx 4 == 2 in
  if ok == false then fail ("mgit: not an idx v2: " ++ base ++ ".idx")
  else
    let n = fanout idx 255 in
    let p = vec_len pk_idx in
    let offs = vec_new () in
    let _ = vec_push pk_idx idx in
    let _ = vec_push pk_file (file_open (base ++ ".pack")) in
    let _ = vec_push pk_size (file_size (base ++ ".pack")) in
    let _ = vec_push pk_count n in
    let rec fill = fn (k: int) -> if k == n then () else let _ = vec_push offs (idx_offset p k) in fill (k + 1) in
    let _ = fill 0 in
    let _ = vec_sort offs (fn (a: int) -> fn (b: int) -> a - b) in
    vec_push pk_offs offs;

let store_open = fn (gd: str) ->
  let _ = vec_push git_dir gd in
  let dir = gd ++ "/objects/pack" in
  let names = if file_exists dir then list_dir dir else Nil in
  list_iter (list_sort names) (fn (f: str) ->
    if str_ends_with f ".idx" then
      open_pack (dir ++ "/" ++ substring f 0 (str_len f - 4))
    else ());

// ---- pack entries -----------------------------------------------------------

// apply a delta to its base (gitformat-pack, "Deltified representation")
let delta_size = fn (d) -> fn (p: int) ->
  let rec go = fn (p: int) -> fn (shift: int) -> fn (acc: int) ->
    let c = bytebuf_get d p in
    let acc2 = bit_or acc (bit_shl (bit_and c 127) shift) in
    if c < 128 then (acc2, p + 1) else go (p + 1) (shift + 7) acc2 in
  go p 0 0;

let apply_delta = fn (base) -> fn (d) ->
  let (src, p1) = delta_size d 0 in
  let (dst, p2) = delta_size d p1 in
  let n = bytebuf_len d in
  let out = bytebuf_new 0 in
  let rec copy_base = fn (i: int) -> fn (e: int) ->
    if i == e then () else let _ = bytebuf_push out (bytebuf_get base i) in copy_base (i + 1) e in
  let rec copy_lit = fn (i: int) -> fn (e: int) ->
    if i == e then () else let _ = bytebuf_push out (bytebuf_get d i) in copy_lit (i + 1) e in
  let rec ops = fn (p: int) ->
    if p >= n then ()
    else
      let op = bytebuf_get d p in
      if op >= 128 then
        // copy: which offset and size bytes follow is said by the low 7 bits
        let rec field = fn (bit: int) -> fn (count: int) -> fn (q: int) -> fn (acc: int) -> fn (k: int) ->
          if k == count then (acc, q)
          else if bit_and op (bit_shl bit k) != 0 then
            field bit count (q + 1) (bit_or acc (bit_shl (bytebuf_get d q) (8 * k))) (k + 1)
          else field bit count q acc (k + 1) in
        let (off, q1) = field 1 4 (p + 1) 0 0 in
        let (sz0, q2) = field 16 3 q1 0 0 in
        let sz = if sz0 == 0 then 65536 else sz0 in
        let _ = if off + sz > bytebuf_len base then fail "mgit: delta copies past its base" else () in
        let _ = copy_base off (off + sz) in
        ops q2
      else if op > 0 then
        let _ = copy_lit (p + 1) (p + 1 + op) in
        ops (p + 1 + op)
      else fail "mgit: delta opcode 0 is reserved" in
  let _ = if src != bytebuf_len base then fail "mgit: delta base has the wrong size" else () in
  let _ = ops p2 in
  let _ = if bytebuf_len out != dst then fail "mgit: delta result has the wrong size" else () in
  out;

// The object at offset o of pack p: (typ, bytes). Deltas are resolved down to
// their base, recursively -- a ref-delta's base may be anywhere in the store.
let rec pack_read = fn (p: int) -> fn (o: int) ->
  let stop = next_offset p o in
  let raw = bytebuf_of_bytes (file_pread_bytes (vec_get pk_file p) o (stop - o)) in
  let c0 = bytebuf_get raw 0 in
  let typ = bit_and (bit_shr c0 4) 7 in
  let rec skip_size = fn (q: int) -> fn (c: int) -> if c < 128 then q else skip_size (q + 1) (bytebuf_get raw q) in
  let hp = skip_size 1 c0 in
  if typ >= 1 && typ <= 4 then
    let (out, _e, ok) = zlib_inflate raw hp in
    let _ = if ok == false then fail "mgit: a packed object's zlib stream is bad" else () in
    (typ, out)
  else if typ == 6 then
    // OBJ_OFS_DELTA: base at o - n, n in the "+1 per continuation" varint
    let rec ofs = fn (q: int) -> fn (acc: int) ->
      let c = bytebuf_get raw q in
      let acc2 = bit_or (bit_shl acc 7) (bit_and c 127) in
      if c < 128 then (acc2, q + 1) else ofs (q + 1) (acc2 + 1) in
    let (n, dp) = ofs hp 0 in
    let (d, _e, ok) = zlib_inflate raw dp in
    let _ = if ok == false then fail "mgit: a delta's zlib stream is bad" else () in
    let (bt, base) = pack_read p (o - n) in
    (bt, apply_delta base d)
  else if typ == 7 then
    let id = hex_of_bytes (bb_range raw hp 20) in
    let (d, _e, ok) = zlib_inflate raw (hp + 20) in
    let _ = if ok == false then fail "mgit: a delta's zlib stream is bad" else () in
    let (bt, base) = store_read id in
    (bt, apply_delta base d)
  else fail ("mgit: pack entry of type " ++ str_of_int typ)

// ---- the store ----------------------------------------------------------------

and loose_read = fn (hex: str) ->
  let path = vec_get git_dir 0 ++ "/objects/" ++ substring hex 0 2 ++ "/" ++ substring hex 2 40 in
  if file_exists path == false then (0, bytebuf_new 0)
  else
    let (out, _e, ok) = zlib_inflate (bytebuf_of_bytes (read_bytes path)) 0 in
    let _ = if ok == false then fail ("mgit: loose object " ++ hex ++ " is not a good zlib stream") else () in
    // "<type> <size>\0<content>"
    let rec nul = fn (i: int) -> if bytebuf_get out i == 0 then i else nul (i + 1) in
    let z = nul 0 in
    let head = str_of_bytes (bb_range out 0 z) in
    let sp = str_index_of head " " in
    let typ = type_of_name (substring head 0 sp) in
    let size = int_of_str (substring head (sp + 1) (str_len head)) in
    let body = bytebuf_new 0 in
    let rec copy = fn (i: int) -> if i == bytebuf_len out then () else let _ = bytebuf_push body (bytebuf_get out i) in copy (i + 1) in
    let _ = copy (z + 1) in
    let _ = if bytebuf_len body != size then fail ("mgit: loose object " ++ hex ++ " is not the size its header says") else () in
    (typ, body)

and store_read = fn (hex: str) ->
  let id = bytes_of_hex hex in
  let rec in_packs = fn (i: int) ->
    if i == vec_len pk_idx then loose_read hex
    else
      let k = idx_find i id in
      if k >= 0 then pack_read i (idx_offset i k) else in_packs (i + 1) in
  in_packs 0;

// every id: the packs' indexes and the loose fan-out directories, once each
let store_all = fn (u: unit) ->
  let seen = map_new () in
  let rec each_pack = fn (p: int) ->
    if p == vec_len pk_idx then ()
    else
      let rec go = fn (k: int) ->
        if k == (vec_get pk_count p : int) then ()
        else
          let _ = map_set seen (hex_of_bytes (bytes_slice (vec_get pk_idx p : bytes) (8 + 1024 + 20 * k) 20)) 1 in
          go (k + 1) in
      let _ = go 0 in
      each_pack (p + 1) in
  let _ = each_pack 0 in
  let od = vec_get git_dir 0 ++ "/objects" in
  let hexdig = fn (s: str) -> str_len s == 2 && str_index_of "0123456789abcdef" (char_at s 0) >= 0
                                          && str_index_of "0123456789abcdef" (char_at s 1) >= 0 in
  let _ = list_iter (list_dir od) (fn (d: str) ->
    if hexdig d then
      list_iter (list_dir (od ++ "/" ++ d)) (fn (f: str) ->
        if str_len f == 38 then map_set seen (d ++ f) 1 else ())
    else ()) in
  let ids = vec_new () in
  let _ = map_iter seen (fn (k: str) -> fn (v: int) -> vec_push ids k) in
  let _ = vec_sort ids (fn (a: str) -> fn (b: str) -> str_compare a b) in
  vec_to_list ids;
